@Component
struct AirQualityCircle {
  @Prop aqi: number = 42

  build() {
    Stack({ alignContent: Alignment.Center }) {
      Canvas(this.renderCanvas)
        .width(220)
        .height(220)

      Column({ space: 0 }) {
        Text('AQI')
          .fontSize(14)
          .fontWeight(FontWeight.Bold)
          .fontColor('#757575')
          .letterSpacing(2)
        Text(`${this.aqi}`)
          .fontSize(80)
          .fontWeight(FontWeight.Medium)
          .fontColor('#1A1A1A')
        Text('Excellent')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor('#4CAF50')
          .padding({ left: 12, right: 12, top: 6, bottom: 6 })
          .backgroundColor('#1A4CAF50')
          .borderRadius(16)
      }
      .alignItems(HorizontalAlign.Center)
    }
    .width('100%')
    .aspectRatio(1.2)
  }

  @Builder
  renderCanvas(context: CanvasRenderingContext2D, size: Size) {
    let lineWidth: number = 40
    let radius: number = (Math.min(size.width, size.height) - lineWidth) / 2
    let centerX: number = size.width / 2
    let centerY: number = size.height / 2

    // Background track
    context.lineWidth = lineWidth
    context.strokeStyle = '#FAFAFA'
    context.lineCap = 'round'
    context.beginPath()
    context.arc(centerX, centerY, radius, Math.PI * 0.75, Math.PI * 0.75 + Math.PI * 1.5, false)
    context.stroke()

    // Progress track
    context.lineWidth = lineWidth
    context.strokeStyle = '#4CAF50'
    context.lineCap = 'round'
    context.beginPath()
    context.arc(centerX, centerY, radius, Math.PI * 0.75, Math.PI * 0.75 + Math.PI * 0.611, false)
    context.stroke()

    // Decorative dot
    let dotRadius: number = 12
    let angleForDot: number = Math.PI * 0.75 + Math.PI * 0.611
    let xOffset: number = radius * Math.cos(angleForDot)
    let yOffset: number = radius * Math.sin(angleForDot)
    let dotCenterX: number = centerX + xOffset
    let dotCenterY: number = centerY + yOffset

    context.fillStyle = '#FFFFFF'
    context.beginPath()
    context.arc(dotCenterX, dotCenterY, dotRadius / 2, 0, Math.PI * 2)
    context.fill()
  }
}

@Component
struct MetricCard {
  @Prop label: string = ''
  @Prop value: string = ''
  @Prop iconName: string = ''
  @Prop statusColor: string = '#1A1A1A'

  build() {
    Column({ space: 0 }) {
      Row() {
        Image($r(`sys.symbol.${this.iconName}`))
          .width(20)
          .height(20)
          .fillColor(this.statusColor)
        Blank()
      }
      .width('100%')

      Blank()
        .layoutWeight(1)

      Column({ space: 4 }) {
        Text(this.value)
          .fontSize(24)
          .fontWeight(FontWeight.SemiBold)
          .fontColor('#1A1A1A')
        Text(this.label)
          .fontSize(12)
          .fontColor('#757575')
      }
      .alignItems(HorizontalAlign.Start)
    }
    .alignItems(HorizontalAlign.Start)
    .padding(16)
    .height(110)
    .layoutWeight(1)
    .backgroundColor('#FAFAFA')
    .borderRadius(24)
  }
}

@Component
struct StatusBanner {
  build() {
    Column({ space: 0 }) {
      Row({ space: 12 }) {
        Image($r('sys.symbol.house_fill'))
          .width(24)
          .height(24)
          .fillColor('#1A1A1A')
        Text('Room Analysis')
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor('#1A1A1A')
      }
      .alignItems(VerticalAlign.Center)

      Blank()
        .height(12)

      Text('Air quality is optimal. Ventilation is not required at this moment. Temperature is stable.')
        .fontSize(14)
        .fontColor('#757575')
        .lineHeight(22)
        .width('100%')
    }
    .alignItems(HorizontalAlign.Start)
    .padding(20)
    .width('100%')
    .borderRadius(20)
    .border({ width: 1, color: '#EEEEEE' })
  }
}

