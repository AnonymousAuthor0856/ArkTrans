  static readonly textPrimary: string = '#000000'
  static readonly iconBackground: string = '#EFEBE9'
  static readonly borderLight: string = '#E0E0E0'
}

@Component
struct TeaBrewingScreen {
  build() {
    Column() {
      // Top Header
      HeaderSection()
        .margin({ top: 24, bottom: 32 })

      // Main Card
      TeaSelectionCard()
        .margin({ bottom: 32 })

      // Timer
      TimerDisplay({ time: '02:00' })
        .margin({ bottom: 40 })

      // Action Buttons
      ControlButtons()

      Blank()
        .layoutWeight(1)

      // Steps
      PreparationSteps()
        .margin({ bottom: 24 })
    }
    .width('100%')
    .height('100%')
    .padding({ left: 24, right: 24 })
    .backgroundColor('#FFFFFF')
  }
}

