# Copy this file to scripts/.env and fill in values for your machine.
# All experiment scripts load scripts/.env centrally.

# Workspace root that the experiment data layout lives under
ARKTRANS_ROOT=/path/to/workspace/ArkTrans

# Toolchain
HVIGORW=/path/to/hvigorw
JAVA_HOME=/path/to/jdk-17/Contents/Home
HOS_SDK_DIR=/path/to/harmonyos/sdk
# Optional override; default resolves to scripts/evaluate/minimal_hos
MINIMAL_HOS_TEMPLATE=

# LLM providers (fill in)
GPT_API_KEY=
GPT_BASE_URL=
GPT_MODEL=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GLM_API_KEY=
GLM_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_TURBO_MODEL=

# Generation parameters
TEMPERATURE=
TOP_P=
MAX_TOKENS=
DEVECO_STUDIO_PATH=
